{"confirm-sign-up": {"subject": "Dein OrgaMe-Code: {{ .Token }}", "html": "<!DOCTYPE html>\n<html lang=\"de\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<meta name=\"color-scheme\" content=\"light\">\n<title>OrgaMe</title>\n</head>\n<body style=\"margin:0;padding:0;background:#eef1f7;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#141a2b;\">\n<div style=\"display:none;max-height:0;overflow:hidden;opacity:0;\">Dein Code: {{ .Token }}</div>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#eef1f7;padding:24px 12px;\">\n  <tr><td align=\"center\">\n    <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:480px;background:#ffffff;border-radius:18px;overflow:hidden;\">\n      <tr><td style=\"background:#070b14;padding:22px 28px;\" align=\"left\">\n        <img src=\"https://onbac.pages.dev/onbac-logo.png\" width=\"120\" alt=\"OrgaMe\" style=\"display:block;border:0;width:120px;height:auto;color:#ffffff;font-size:22px;font-weight:700;\">\n      </td></tr>\n      <tr><td style=\"padding:28px 28px 8px;\">\n        <h1 style=\"margin:0 0 10px;font-size:22px;line-height:1.3;color:#141a2b;\">Dein Code für OrgaMe</h1>\n        <p style=\"margin:0 0 22px;font-size:16px;line-height:1.5;color:#3b4459;\">Gib diesen Code ein, um deine E-Mail-Adresse zu bestätigen und loszulegen.</p>\n        <div style=\"text-align:center;margin:0 0 22px;\">\n          <div style=\"display:inline-block;padding:16px 26px;border-radius:14px;background:#f2f6ff;border:1px solid #cddcff;font-size:32px;font-weight:800;letter-spacing:8px;color:#1E6BFF;font-family:'SFMono-Regular',Menlo,Consolas,monospace;\">{{ .Token }}</div>\n        </div>\n        <p style=\"margin:0 0 8px;font-size:14px;line-height:1.5;color:#5a6378;\">Der Code gilt nur kurze Zeit und nur einmal. Ein Passwort brauchst du nicht.</p>\n        <p style=\"margin:0 0 24px;font-size:14px;line-height:1.5;color:#5a6378;\">Falls du dich nicht bei OrgaMe registrieren wolltest, kannst du diese E-Mail ignorieren.</p>\n      </td></tr>\n      <tr><td style=\"padding:16px 28px 22px;border-top:1px solid #e6e9f0;font-size:12px;line-height:1.5;color:#8a92a6;\">\n        OrgaMe – die Vereins-App · <a href=\"https://orga.me\" style=\"color:#8a92a6;\">orga.me</a><br>\n        Diese E-Mail wurde an {{ .Email }} gesendet.\n      </td></tr>\n    </table>\n  </td></tr>\n</table>\n</body>\n</html>\n"}, "magic-link": {"subject": "Dein OrgaMe-Anmeldecode: {{ .Token }}", "html": "<!DOCTYPE html>\n<html lang=\"de\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<meta name=\"color-scheme\" content=\"light\">\n<title>OrgaMe</title>\n</head>\n<body style=\"margin:0;padding:0;background:#eef1f7;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#141a2b;\">\n<div style=\"display:none;max-height:0;overflow:hidden;opacity:0;\">Dein Anmeldecode: {{ .Token }}</div>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#eef1f7;padding:24px 12px;\">\n  <tr><td align=\"center\">\n    <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:480px;background:#ffffff;border-radius:18px;overflow:hidden;\">\n      <tr><td style=\"background:#070b14;padding:22px 28px;\" align=\"left\">\n        <img src=\"https://onbac.pages.dev/onbac-logo.png\" width=\"120\" alt=\"OrgaMe\" style=\"display:block;border:0;width:120px;height:auto;color:#ffffff;font-size:22px;font-weight:700;\">\n      </td></tr>\n      <tr><td style=\"padding:28px 28px 8px;\">\n        <h1 style=\"margin:0 0 10px;font-size:22px;line-height:1.3;color:#141a2b;\">Dein Anmeldecode</h1>\n        <p style=\"margin:0 0 22px;font-size:16px;line-height:1.5;color:#3b4459;\">Gib diesen Code in der OrgaMe-App oder auf orga.me ein, um dich anzumelden.</p>\n        <div style=\"text-align:center;margin:0 0 22px;\">\n          <div style=\"display:inline-block;padding:16px 26px;border-radius:14px;background:#f2f6ff;border:1px solid #cddcff;font-size:32px;font-weight:800;letter-spacing:8px;color:#1E6BFF;font-family:'SFMono-Regular',Menlo,Consolas,monospace;\">{{ .Token }}</div>\n        </div>\n        <p style=\"margin:0 0 8px;font-size:14px;line-height:1.5;color:#5a6378;\">Der Code gilt nur kurze Zeit und nur einmal. Ein Passwort brauchst du nicht.</p>\n        <p style=\"margin:0 0 24px;font-size:14px;line-height:1.5;color:#5a6378;\">Falls du dich nicht anmelden wolltest, kannst du diese E-Mail ignorieren – dein Konto bleibt geschützt.</p>\n      </td></tr>\n      <tr><td style=\"padding:16px 28px 22px;border-top:1px solid #e6e9f0;font-size:12px;line-height:1.5;color:#8a92a6;\">\n        OrgaMe – die Vereins-App · <a href=\"https://orga.me\" style=\"color:#8a92a6;\">orga.me</a><br>\n        Diese E-Mail wurde an {{ .Email }} gesendet.\n      </td></tr>\n    </table>\n  </td></tr>\n</table>\n</body>\n</html>\n"}, "change-email": {"subject": "Neue E-Mail-Adresse bestätigen – Code {{ .Token }}", "html": "<!DOCTYPE html>\n<html lang=\"de\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<meta name=\"color-scheme\" content=\"light\">\n<title>OrgaMe</title>\n</head>\n<body style=\"margin:0;padding:0;background:#eef1f7;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#141a2b;\">\n<div style=\"display:none;max-height:0;overflow:hidden;opacity:0;\">Code zur Bestätigung: {{ .Token }}</div>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#eef1f7;padding:24px 12px;\">\n  <tr><td align=\"center\">\n    <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:480px;background:#ffffff;border-radius:18px;overflow:hidden;\">\n      <tr><td style=\"background:#070b14;padding:22px 28px;\" align=\"left\">\n        <img src=\"https://onbac.pages.dev/onbac-logo.png\" width=\"120\" alt=\"OrgaMe\" style=\"display:block;border:0;width:120px;height:auto;color:#ffffff;font-size:22px;font-weight:700;\">\n      </td></tr>\n      <tr><td style=\"padding:28px 28px 8px;\">\n        <h1 style=\"margin:0 0 10px;font-size:22px;line-height:1.3;color:#141a2b;\">Neue E-Mail-Adresse bestätigen</h1>\n        <p style=\"margin:0 0 22px;font-size:16px;line-height:1.5;color:#3b4459;\">Gib diesen Code in der OrgaMe-App ein, um {{ .NewEmail }} als neue Adresse für dein Konto zu bestätigen.</p>\n        <div style=\"text-align:center;margin:0 0 22px;\">\n          <div style=\"display:inline-block;padding:16px 26px;border-radius:14px;background:#f2f6ff;border:1px solid #cddcff;font-size:32px;font-weight:800;letter-spacing:8px;color:#1E6BFF;font-family:'SFMono-Regular',Menlo,Consolas,monospace;\">{{ .Token }}</div>\n        </div>\n        <p style=\"margin:0 0 8px;font-size:14px;line-height:1.5;color:#5a6378;\">Der Code gilt nur kurze Zeit und nur einmal. Ein Passwort brauchst du nicht.</p>\n        <p style=\"margin:0 0 24px;font-size:14px;line-height:1.5;color:#5a6378;\">Falls du deine E-Mail-Adresse nicht ändern wolltest, ignoriere diese E-Mail. Deine bisherige Adresse bleibt gültig.</p>\n      </td></tr>\n      <tr><td style=\"padding:16px 28px 22px;border-top:1px solid #e6e9f0;font-size:12px;line-height:1.5;color:#8a92a6;\">\n        OrgaMe – die Vereins-App · <a href=\"https://orga.me\" style=\"color:#8a92a6;\">orga.me</a><br>\n        Diese E-Mail wurde an {{ .Email }} gesendet.\n      </td></tr>\n    </table>\n  </td></tr>\n</table>\n</body>\n</html>\n"}}